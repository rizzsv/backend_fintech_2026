NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=debug

DB_HOST=postgres
DB_PORT=5432
DB_NAME=fintech
DB_USER=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=change-me-in-production

# Public backend URL used to construct email verification links.
APP_URL=http://localhost:3000

# Public frontend URL that receives the email verification link
# (<FRONTEND_URL>/verify-email?token=...). Falls back to APP_URL when unset.
FRONTEND_URL=http://localhost:3002

# SMTP transport and sender identity for transactional email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_EMAIL=no-reply@example.com