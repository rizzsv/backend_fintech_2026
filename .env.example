NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=debug

DB_HOST=postgres
DB_PORT=5432
DB_NAME=fintech
DB_USER=postgres
DB_PASSWORD=your-secure-db-password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password

JWT_SECRET=your-secure-jwt-secret-min-32-chars

# Public backend URL used to construct email verification links.
APP_URL=http://localhost:3000

# Public frontend URL that receives the email verification link
# (<FRONTEND_URL>/verify-email?token=...). Falls back to APP_URL when unset.
FRONTEND_URL=http://localhost:3002

# SMTP transport and sender identity for transactional email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_EMAIL=no-reply@example.com

# Midtrans payment gateway
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_IS_PRODUCTION=false

# Payment mode: 'simulated' for portfolio/testing (no real money), 'production' for real payment gateway
PAYMENT_MODE=simulated

# Withdrawal webhook signature secret
WITHDRAWAL_WEBHOOK_SECRET=your-secure-webhook-secret-min-32-chars

# Bull Board (queue monitoring)
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=your-secure-bull-board-password

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback