# Production Environment Configuration
# Copy to .env and fill with actual values

# Runtime
NODE_ENV=production
PORT=3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.neon.tech:5432/dbname?sslmode=require

# Redis (Upstash Redis)
REDIS_HOST=your-redis.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-upstash-redis-password

# JWT
JWT_SECRET=your-production-jwt-secret-min-32-chars

# Logging
LOG_LEVEL=info

# Payment Gateway (Midtrans Sandbox for demo)
MIDTRANS_SERVER_KEY=your-midtrans-sandbox-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-sandbox-client-key
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com/v2
MIDTRANS_IS_PRODUCTION=false

# Withdrawal webhook
WITHDRAWAL_WEBHOOK_SECRET=your-webhook-secret

# Bull Board monitoring
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=your-secure-password

# Financial mode (MUST remain simulated for demo/portfolio)
PAYMENT_MODE=simulated

# Queue provider for serverless deployment
QUEUE_PROVIDER=qstash

# QStash (Upstash QStash)
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-next-signing-key

# Backend URL (your deployed backend domain)
BACKEND_URL=https://your-backend-domain.com

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.com
