# Node environment
NODE_ENV=development

# Server port
APP_PORT=3000

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT secret
JWT_SECRET=your_jwt_secret_key_here

# Logging
LOG_LEVEL=info

# Midtrans payment gateway
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com/v2
MIDTRANS_IS_PRODUCTION=false

# Withdrawal webhook secret
WITHDRAWAL_WEBHOOK_SECRET=your_withdrawal_webhook_secret

# Bull Board (queue monitoring)
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=your_bull_board_password

# Payment mode: 'simulated' for demo/portfolio, 'production' for real payments
PAYMENT_MODE=simulated

# Queue provider: 'bullmq' for persistent workers, 'qstash' for serverless
QUEUE_PROVIDER=bullmq

# QStash configuration (required when QUEUE_PROVIDER=qstash)
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_next_signing_key

# Backend URL for QStash callbacks (required when QUEUE_PROVIDER=qstash)
BACKEND_URL=https://your-backend-domain.com

# Database URL (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database
