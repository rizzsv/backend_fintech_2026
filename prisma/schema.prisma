generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                  @id @default(uuid())
  email                      String                  @unique
  phoneNumber                String                  @unique @map("phone_number")
  passwordHash               String                  @map("password_hash")
  firstName                  String?                 @map("first_name")
  lastName                   String?                 @map("last_name")
  role                       UserRole                @default(USER)
  kycStatus                  KycStatus               @default(PENDING) @map("kyc_status")
  kycTier                    KycTier                 @default(BASIC) @map("kyc_tier")
  kycDocumentPath            String?                 @map("kyc_document_path")
  kycSelfiePath              String?                 @map("kyc_selfie_path")
  isActive                   Boolean                 @default(true) @map("is_active")
  deletedAt                  DateTime?               @map("deleted_at")
  createdAt                  DateTime                @default(now()) @map("created_at")
  updatedAt                  DateTime                @updatedAt @map("updated_at")
  emailVerificationExpiresAt DateTime?
  emailVerificationToken     String?
  isEmailVerified            Boolean                 @default(false)
  payments                   Payment[]
  auditLogs                  AuditLog[]
  fraudCases                 FraudCase[]
  kycRequests                KycRequest[]
  notificationPreference     NotificationPreference?
  notifications              Notification[]
  sessions                   Session[]
  devices                    UserDevice[]
  userLimit                  UserLimit?
  wallet                     Wallet?
  withdrawals                Withdrawal[]

  @@index([kycStatus], map: "idx_users_kyc_status")
  @@map("users")
}

model Wallet {
  id                   String        @id @default(uuid())
  currency             String        @default("IDR")
  balance              Decimal       @default(0) @db.Decimal(18, 2)
  version              Int           @default(0)
  isFrozen             Boolean       @default(false) @map("is_frozen")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  userId               String        @unique
  ledgerEntries        LedgerEntry[]
  outgoingTransactions Transaction[] @relation("FromWallet")
  incomingTransactions Transaction[] @relation("ToWallet")
  user                 User          @relation(fields: [userId], references: [id])
  withdrawals          Withdrawal[]

  @@unique([userId, currency])
  @@index([userId], map: "idx_wallets_user_id")
  @@map("wallets")
}

model Transaction {
  id                String            @id @default(uuid())
  fromWalletId      String?           @map("from_wallet_id")
  toWalletId        String            @map("to_wallet_id")
  amount            Decimal           @db.Decimal(18, 2)
  fee               Decimal           @default(0) @db.Decimal(18, 2)
  transactionType   TransactionType   @map("transaction_type")
  status            TransactionStatus
  description       String?
  referenceNumber   String?           @unique @map("reference_number")
  idempotencyKey    String            @unique @map("idempotency_key")
  createdAt         DateTime          @default(now()) @map("created_at")
  completedAt       DateTime?         @map("completed_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  metadata          Json?
  paymentType       String?
  externalReference String?           @map("external_reference")
  paymentChannel    String?           @map("payment_channel")
  ledgerEntries     LedgerEntry[]
  logs              TransactionLog[]
  fromWallet        Wallet?           @relation("FromWallet", fields: [fromWalletId], references: [id], onDelete: Restrict)
  toWallet          Wallet            @relation("ToWallet", fields: [toWalletId], references: [id])

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([idempotencyKey], map: "idx_tx_idempotency")
  @@map("transactions")
}

model LedgerEntry {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  walletId      String      @map("wallet_id")
  entryType     EntryType   @map("entry_type")
  amount        Decimal     @db.Decimal(18, 2)
  balanceAfter  Decimal     @map("balance_after") @db.Decimal(18, 2)
  createdAt     DateTime    @default(now()) @map("created_at")
  description   String?
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  wallet        Wallet      @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt], map: "idx_ledger_wallet")
  @@index([transactionId], map: "idx_ledger_transaction")
  @@index([walletId, transactionId], map: "idx_ledger_wallet_transaction")
  @@map("ledger_entries")
}

model TransactionLog {
  id            String             @id @default(uuid())
  transactionId String             @map("transaction_id")
  event         String
  statusBefore  TransactionStatus? @map("status_before")
  statusAfter   TransactionStatus? @map("status_after")
  metadata      Json?
  createdAt     DateTime           @default(now()) @map("created_at")
  transaction   Transaction        @relation(fields: [transactionId], references: [id])

  @@index([transactionId, createdAt], map: "idx_tx_logs_transaction")
  @@map("transaction_logs")
}

model UserLimit {
  userId       String   @id @map("user_id")
  dailyLimit   Decimal  @map("daily_limit") @db.Decimal(18, 2)
  monthlyLimit Decimal  @map("monthly_limit") @db.Decimal(18, 2)
  dailyUsed    Decimal  @default(0) @map("daily_used") @db.Decimal(18, 2)
  monthlyUsed  Decimal  @default(0) @map("monthly_used") @db.Decimal(18, 2)
  lastResetAt  DateTime @default(now()) @map("last_reset_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id])

  @@map("user_limits")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  deviceName       String?   @map("device_name")
  deviceIp         String?   @map("device_ip")
  userAgent        String?   @map("user_agent")
  isActive         Boolean   @default(true) @map("is_active")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastActivity     DateTime? @map("last_activity")
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, isActive], map: "idx_sessions_user")
  @@index([refreshTokenHash], map: "idx_sessions_refresh_token")
  @@map("sessions")
}

model UserDevice {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  deviceId    String   @map("device_id")
  fingerprint String
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId], map: "uq_user_device")
  @@index([userId], map: "idx_user_devices_user")
  @@index([deviceId], map: "idx_user_devices_device")
  @@map("user_devices")
}

model KycRequest {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  documentPath String?   @map("document_path")
  selfiePath   String?   @map("selfie_path")
  status       KycStatus @default(PENDING)
  reviewNote   String?   @map("review_note")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId, status], map: "idx_kyc_user_status")
  @@map("kyc_requests")
}

model FraudCase {
  id         String          @id @default(uuid())
  userId     String          @map("user_id")
  riskScore  Int
  reason     String
  status     FraudCaseStatus @default(OPEN)
  metadata   Json?
  createdAt  DateTime        @default(now()) @map("created_at")
  resolvedAt DateTime?       @map("resolved_at")
  user       User            @relation(fields: [userId], references: [id])

  @@index([userId, status], map: "idx_fraud_user_status")
  @@map("fraud_cases")
}

model Notification {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  type         String
  title        String
  message      String
  isRead       Boolean             @default(false) @map("is_read")
  createdAt    DateTime            @default(now()) @map("created_at")
  channel      NotificationChannel
  entityId     String?             @map("entity_id")
  failedAt     DateTime?           @map("failed_at")
  failedReason String?             @map("failed_reason")
  metadata     Json?
  readAt       DateTime?           @map("read_at")
  resource     String?
  retryCount   Int                 @default(0) @map("retry_count")
  sentAt       DateTime?           @map("sent_at")
  status       NotificationStatus  @default(PENDING)
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id])

  @@index([userId, status, createdAt], map: "idx_notifications_user_status")
  @@index([userId, isRead, createdAt], map: "idx_notifications_user_read")
  @@index([resource, entityId], map: "idx_notifications_resource_entity")
  @@index([channel, status], map: "idx_notifications_channel_status")
  @@map("notifications")
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String   @unique(map: "uq_notification_preferences_user") @map("user_id")
  inApp     Boolean  @default(true) @map("in_app")
  email     Boolean  @default(true)
  push      Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  resource  String
  metadata  Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  actorType String   @default("USER") @map("actor_type")
  entityId  String?  @map("entity_id")
  requestId String?  @map("request_id")
  status    String   @default("SUCCESS")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt], map: "idx_audit_user")
  @@index([resource, createdAt], map: "idx_audit_resource")
  @@index([requestId], map: "idx_audit_request")
  @@index([createdAt], map: "idx_audit_created")
  @@map("audit_logs")
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  amount            Decimal       @db.Decimal(18, 2)
  status            PaymentStatus
  paymentMethod     String
  externalReference String?
  expiredAt         DateTime
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  provider          String
  providerResponse  Json?
  referenceNumber   String        @unique
  paymentUrl        String?
  qrUrl             String?
  user              User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([referenceNumber])
}

model Withdrawal {
  id                String           @id @default(uuid())
  userId            String           @map("user_id")
  walletId          String           @map("wallet_id")
  amount            Decimal          @db.Decimal(18, 2)
  fee               Decimal          @default(0) @db.Decimal(18, 2)
  netAmount         Decimal          @map("net_amount") @db.Decimal(18, 2)
  method            WithdrawalMethod
  bankCode          String?          @map("bank_code")
  bankName          String?          @map("bank_name")
  accountNumber     String?          @map("account_number")
  accountName       String?          @map("account_name")
  referenceNumber   String           @unique @map("reference_number")
  providerReference String?          @map("provider_reference")
  status            withdrawalStatus @default(PENDING)
  providerResponse  Json?
  processedAt       DateTime?        @map("processed_at")
  failedReason      String?          @map("failed_reason")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  idempotencyKey    String?          @unique @map("idempotency_key")
  user              User             @relation(fields: [userId], references: [id])
  wallet            Wallet           @relation(fields: [walletId], references: [id])

  @@index([userId], map: "idx_withdrawal_user")
  @@index([walletId], map: "idx_withdrawal_wallet")
  @@index([status], map: "idx_withdrawal_status")
  @@index([referenceNumber], map: "idx_withdrawal_reference")
  @@map("withdrawals")
}

enum KycStatus {
  PENDING
  APPROVED
  VERIFIED
  REJECTED

  @@map("kyc_status")
}

enum UserRole {
  USER
  ADMIN
  SUPPORT

  @@map("user_role")
}

enum KycTier {
  BASIC
  VERIFIED
  PREMIUM

  @@map("kyc_tier")
}

enum TransactionType {
  TRANSFER
  TOPUP
  WITHDRAWAL
  REFUND

  @@map("transaction_type")
}

enum TransactionStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REVERSED

  @@map("transaction_status")
}

enum withdrawalStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED

  @@map("withdrawal_status")
}

enum EntryType {
  DEBIT
  CREDIT

  @@map("entry_type")
}

enum FraudCaseStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED

  @@map("fraud_case_status")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum WithdrawalMethod {
  BANK_TRANSFER
  EWALLET
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  READ
  SKIPPED
}
