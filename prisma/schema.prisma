// PRISMA SCHEMA — Digital Wallet (OVO/DANA-inspired)
// Merged from: SQL production schema + Prisma V1
// Key design decisions:
//   - Transactions reference wallets (not users) for financial integrity
//   - Double-entry ledger is the source of truth for balances
//   - Wallet.balance is a cached value, always reconcilable via ledger
//   - Optimistic locking via wallet.version prevents race conditions
//   - Idempotency lives on Transaction, not a separate table
//   - Sessions handle refresh token rotation securely

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("kyc_status")
}

enum KycTier {
  BASIC // lowest limits
  VERIFIED // mid limits
  PREMIUM // highest limits

  @@map("kyc_tier")
}

enum TransactionType {
  TRANSFER
  TOPUP
  WITHDRAWAL
  REFUND

  @@map("transaction_type")
}

enum TransactionStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REVERSED

  @@map("transaction_status")
}

enum withdrawalStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED

  @@map("withdrawal_status")
}

enum EntryType {
  DEBIT
  CREDIT

  @@map("entry_type")
}

enum FraudCaseStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED

  @@map("fraud_case_status")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum WithdrawalMethod {
  BANK_TRANSFER
  EWALLET
}

// USER

model User {
  id                         String                                                                                @id @default(uuid())
  email                      String                                                                                @unique
  phoneNumber                String         @map("phone_number")                                                   @unique
  passwordHash               String         @map("password_hash")
  firstName                  String?        @map("first_name")
  lastName                   String?        @map("last_name")

  // KYC state — drives transaction limits via UserLimit
  kycStatus                  KycStatus      @map("kyc_status")                                                     @default(PENDING)
  kycTier                    KycTier        @map("kyc_tier")                                                       @default(BASIC)

  // Store private storage PATHS only; generate signed URLs at app layer
  kycDocumentPath            String?        @map("kyc_document_path")
  kycSelfiePath              String?        @map("kyc_selfie_path")

  isActive                   Boolean        @map("is_active")                                                      @default(true)
  deletedAt                  DateTime?      @map("deleted_at") // soft delete — never hard-delete financial actors

  isEmailVerified            Boolean                                                                               @default(false)

  emailVerificationToken     String?

  emailVerificationExpiresAt DateTime?

  createdAt                  DateTime       @map("created_at")                                                     @default(now())
  updatedAt                  DateTime       @map("updated_at")                                                     @updatedAt

  //                         Relations
  wallet                     Wallet[]
  sessions                   Session[]
  kycRequests                KycRequest[]
  userLimit                  UserLimit?
  notifications              Notification[]
  fraudCases                 FraudCase[]
  auditLogs                  AuditLog[]
  payments                   Payment[]
  withdrawals Withdrawal[]

  @@index([kycStatus], map: "idx_users_kyc_status")
  @@map("users")
}

// WALLET

model Wallet {
  id                   String                           @id @default(uuid())
  userId               String                           @unique
  currency             String                           @default("IDR")

  // Cached balance — source of truth is ledger_entries.
  // Must always equal: SELECT SUM(amount) FROM ledger_entries WHERE wallet_id = this.id
  balance              Decimal                          @default(0) @db.Decimal(18, 2)

  // Optimistic locking guard.
  // Every mutation: UPDATE wallets SET balance=?, version=version+1 WHERE id=? AND version=?
  // If 0 rows affected → someone else updated first → retry the transaction.
  version              Int                              @default(0)

  isFrozen             Boolean       @map("is_frozen")  @default(false)

  createdAt            DateTime      @map("created_at") @default(now())
  updatedAt            DateTime      @map("updated_at") @updatedAt

  //                   Relations
  user                 User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  outgoingTransactions Transaction[] @relation("FromWallet")
  incomingTransactions Transaction[] @relation("ToWallet")
  ledgerEntries        LedgerEntry[]
  withdrawals Withdrawal[]

  // One wallet per currency per user
  @@unique([userId,    currency])
  @@index([userId], map: "idx_wallets_user_id")

  @@map("wallets")
}

// TRANSACTION
// The "intent" / envelope of a money movement.
// Wallet references (not user) for financial correctness.

model Transaction {
  id              String                                     @id @default(uuid())

  fromWalletId    String?            @map("from_wallet_id")
  toWalletId      String            @map("to_wallet_id")

  amount          Decimal                                    @db.Decimal(18,2)
  fee             Decimal                                   @default(0) @db.Decimal(18,2)

  transactionType TransactionType                            @map("transaction_type")
  status          TransactionStatus

  paymentChannel   String?           @map("payment_channel")

  description     String?

  referenceNumber String?           @map("reference_number") @unique
  idempotencyKey  String            @map("idempotency_key") @unique
  paymentType String?
  metadata Json?
  

  createdAt       DateTime          @map("created_at")       @default(now())
  updatedAt       DateTime          @map("updated_at")       @updatedAt
  completedAt     DateTime?         @map("completed_at")

  fromWallet      Wallet?            @relation("FromWallet", fields: [fromWalletId], references: [id], onDelete: Restrict)

  toWallet        Wallet            @relation("ToWallet", fields: [toWalletId], references: [id], onDelete: Restrict)
  
  externalReference String? @map("external_reference")

  ledgerEntries   LedgerEntry[]

  logs            TransactionLog[]

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([idempotencyKey], map: "idx_tx_idempotency")

  @@map("transactions")
}

// LEDGER ENTRIES — Immutable, append-only double-entry book.
// Every transaction produces 2+ balanced rows (debit + credit).
// NEVER UPDATE or DELETE a row; corrections = new offsetting entries.

model LedgerEntry {
  id            String                             @id @default(uuid())
  transactionId String      @map("transaction_id")
  walletId      String      @map("wallet_id")
  description   String?

  entryType     EntryType   @map("entry_type")
  amount        Decimal                            @db.Decimal(18, 2)
  balanceAfter  Decimal     @map("balance_after")  @db.Decimal(18, 2) // snapshot, makes statement queries cheap

  createdAt     DateTime    @map("created_at")     @default(now())

  //            Relations
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  wallet        Wallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt], map: "idx_ledger_wallet")
  @@index([transactionId], map: "idx_ledger_transaction")
  @@index([walletId, transactionId], map: "idx_ledger_wallet_transaction")
  @@map("ledger_entries")
}

// TRANSACTION LOGS — Status audit trail (append-only)

model TransactionLog {
  id            String                                    @id @default(uuid())
  transactionId String             @map("transaction_id")

  event         String
  statusBefore  TransactionStatus? @map("status_before")
  statusAfter   TransactionStatus? @map("status_after")

  metadata      Json?

  createdAt     DateTime           @map("created_at")     @default(now())

  transaction   Transaction        @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId, createdAt], map: "idx_tx_logs_transaction")
  @@map("transaction_logs")
}

// USER LIMITS — KYC-tier based transaction limits

model UserLimit {
  userId       String   @map("user_id")       @id

  dailyLimit   Decimal  @map("daily_limit")   @db.Decimal(18, 2)
  monthlyLimit Decimal  @map("monthly_limit") @db.Decimal(18, 2)
  dailyUsed    Decimal  @map("daily_used")    @default(0) @db.Decimal(18, 2)
  monthlyUsed  Decimal  @map("monthly_used")  @default(0) @db.Decimal(18, 2)

  lastResetAt  DateTime @map("last_reset_at") @default(now())
  updatedAt    DateTime @map("updated_at")    @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_limits")
}

// SESSIONS — Refresh token management

model Session {
  id               String                                                         @id @default(uuid())
  userId           String    @map("user_id")

  refreshTokenHash String    @map("refresh_token_hash") // never store raw tokens

  deviceName       String?   @map("device_name")
  deviceIp         String?   @map("device_ip") // IPv6-safe, max 45 chars
  userAgent        String?   @map("user_agent")

  isActive         Boolean   @map("is_active")                                    @default(true)
  expiresAt        DateTime  @map("expires_at")

  createdAt        DateTime  @map("created_at")                                   @default(now())
  lastActivity     DateTime? @map("last_activity")

  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, isActive], map: "idx_sessions_user")
  @@index([refreshTokenHash], map: "idx_sessions_refresh_token")
  @@map("sessions")
}

// KYC REQUEST

model KycRequest {
  id           String                                                  @id @default(uuid())
  userId       String    @map("user_id")

  // Store paths to private storage — generate signed URLs at app layer
  documentPath String?   @map("document_path")
  selfiePath   String?   @map("selfie_path")

  status       KycStatus                                               @default(PENDING)
  reviewNote   String?   @map("review_note") // rejection reason, etc.
  reviewedAt   DateTime? @map("reviewed_at")

  createdAt    DateTime  @map("created_at")                            @default(now())
  updatedAt    DateTime  @map("updated_at")                            @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status], map: "idx_kyc_user_status")
  @@map("kyc_requests")
}

// FRAUD CASE

model FraudCase {
  id         String                              @id @default(uuid())
  userId     String          @map("user_id")

  riskScore  Int
  reason     String
  status     FraudCaseStatus                     @default(OPEN)

  metadata   Json?

  createdAt  DateTime        @map("created_at")  @default(now())
  resolvedAt DateTime?       @map("resolved_at")

  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status], map: "idx_fraud_user_status")
  @@map("fraud_cases")
}

// NOTIFICATION

model Notification {
  id        String                      @id @default(uuid())
  userId    String   @map("user_id")

  type      String

  title     String
  message   String
  isRead    Boolean  @map("is_read")    @default(false)

  createdAt DateTime @map("created_at") @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, isRead], map: "idx_notifications_user_read")
  @@map("notifications")
}

// AUDIT LOG — System-wide action trail

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")

  actorType   String   @default("USER") @map("actor_type")
  action      String
  resource    String
  entityId    String?  @map("entity_id")
  status      String   @default("SUCCESS")

  requestId   String?  @map("request_id")
  metadata    Json?

  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")

  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt], map: "idx_audit_user")
  @@index([resource, createdAt], map: "idx_audit_resource")
  @@index([requestId], map: "idx_audit_request")
  @@index([createdAt], map: "idx_audit_created")

  @@map("audit_logs")
}
model Payment {
  id                String         @id @default(uuid())
  userId            String
  amount            Decimal        @db.Decimal(18,2)
  status            PaymentStatus
  paymentMethod     String
  provider          String
  referenceNumber   String         @unique
  externalReference String?
  paymentUrl        String?
  qrUrl             String?
  providerResponse  Json?
  expiredAt         DateTime
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user              User          @relation(fields:[userId], references:[id])

  @@index([userId])
  @@index([status])
  @@index([referenceNumber])
}

model Withdrawal {
  id                String             @id @default(uuid())

  userId            String             @map("user_id")
  walletId          String             @map("wallet_id")

  amount            Decimal            @db.Decimal(18, 2)
  fee               Decimal            @default(0) @db.Decimal(18, 2)
  netAmount         Decimal            @map("net_amount") @db.Decimal(18, 2)

  method            WithdrawalMethod

  bankCode          String?            @map("bank_code")
  bankName          String?            @map("bank_name")

  accountNumber     String?            @map("account_number")
  accountName       String?            @map("account_name")

  referenceNumber   String             @unique @map("reference_number")
  providerReference String?            @map("provider_reference")

  status            withdrawalStatus   @default(PENDING)

  providerResponse  Json?

  processedAt       DateTime?          @map("processed_at")

  failedReason      String?            @map("failed_reason")

  idempotencyKey     String?             @map("idempotency_key") @unique

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  wallet            Wallet             @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId], map: "idx_withdrawal_user")
  @@index([walletId], map: "idx_withdrawal_wallet")
  @@index([status], map: "idx_withdrawal_status")
  @@index([referenceNumber], map: "idx_withdrawal_reference")

  @@map("withdrawals")
}

