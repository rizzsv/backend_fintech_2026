# Production Environment Configuration (Vercel Deployment)
# Copy to .env in Vercel dashboard

# Runtime
NODE_ENV=production
PORT=3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.neon.tech:5432/dbname?sslmode=require

# Redis (Upstash Redis - REQUIRED for security)
REDIS_HOST=your-redis.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-upstash-redis-password

# JWT
JWT_SECRET=your-production-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-production-jwt-refresh-secret-min-32-chars

# Logging
LOG_LEVEL=info

# Payment Gateway (Midtrans Sandbox for demo)
MIDTRANS_SERVER_KEY=your-midtrans-sandbox-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-sandbox-client-key
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com/v2
MIDTRANS_IS_PRODUCTION=false

# Financial mode (MUST remain simulated for demo/portfolio)
PAYMENT_MODE=simulated

# SMTP (for OTP emails only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=noreply@yourapp.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-backend-domain.vercel.app/api/v1/auth/google/callback

# Backend URL (your deployed backend domain)
BACKEND_URL=https://your-backend-domain.vercel.app

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Features disabled for Vercel deployment
# ENABLE_BULL_BOARD=false (monitoring dashboard disabled)
# QUEUE_PROVIDER=none (background workers disabled)
# KYC file upload disabled (ephemeral filesystem)
